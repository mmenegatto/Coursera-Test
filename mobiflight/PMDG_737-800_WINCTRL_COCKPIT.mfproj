            "onChange": {
              "Command": "@ (>L:MF_THR2_RAW, number) (L:MF_THR2_DET, number) 1 == if{ @ 1 + (>L:MF_THR2_IDLE, number) } (L:MF_THR2_DET, number) 2 == if{ @ 1 + (>L:MF_THR2_TOGA, number) } (L:MF_THR2_DET, number) 3 == if{ @ 1 + (>L:MF_THR2_FULLREV, number) } (L:MF_THR2_IDLE, number) 0 > if{ (L:MF_THR2_IDLE, number) 1 - } els{ 16384 } s4 (L:MF_THR2_TOGA, number) 0 > if{ (L:MF_THR2_TOGA, number) 1 - } els{ 65535 } s5 (L:MF_THR2_FULLREV, number) 0 > if{ (L:MF_THR2_FULLREV, number) 1 - } els{ 0 } s6 @ l4 < (L:MF_THR2_REVLATCH, number) and if{ l4 @ - l4 l6 - / 0 max 1 min 19 * near 1 + } els{ 0 } (>L:MF_THR2_REVTGT, number) @ l4 - l5 l4 - / 0 max 1 min 32768 * 16384 - flr (>L:MF_THR2_FWD, number)",
